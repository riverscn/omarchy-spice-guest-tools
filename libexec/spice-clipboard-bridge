#!/usr/bin/env bash

set -u

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -f ${script_dir}/common.sh ]]; then
  # Source-tree layout.
  common_source="${script_dir}/common.sh"
elif [[ ${script_dir} == /usr/bin && -f /usr/lib/spice-guest-tools/common.sh ]]; then
  # A system package takes precedence over an older per-user installation.
  common_source=/usr/lib/spice-guest-tools/common.sh
elif [[ -f ${HOME}/.local/lib/spice-guest-tools/common.sh ]]; then
  common_source="${HOME}/.local/lib/spice-guest-tools/common.sh"
else
  common_source=/usr/lib/spice-guest-tools/common.sh
fi
# shellcheck disable=SC1090
source "${common_source}"
clipboard_source="$(dirname -- "${common_source}")/clipboard.sh"
# shellcheck disable=SC1090
source "${clipboard_source}"

load_config
[[ ${CLIPBOARD_ENABLED} == true ]] || exit 0
require_commands flock loginctl clipnotify xclip wl-copy wl-paste cmp stat || exit 1

base_runtime=$(runtime_dir)
mkdir -p -- "${base_runtime}"
chmod 700 "${base_runtime}"
exec 9>"${base_runtime}/clipboard.lock"
flock -n 9 || exit 0

work_dir=$(mktemp -d "${base_runtime}/clipboard.XXXXXX")
events="${work_dir}/events"
last="${work_dir}/last"
last_type="${work_dir}/last.type"
current="${work_dir}/current"
mkfifo "${events}"
exec 8<>"${events}"
: >"${last}"
: >"${last_type}"

cleanup() {
  jobs -pr | xargs -r kill 2>/dev/null || true
  rm -f -- "${events}" "${last}" "${last_type}" "${current}"
  rmdir -- "${work_dir}" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 0' INT TERM

within_limit() {
  local file=$1 bytes
  bytes=$(stat -c %s "${file}") || return 1
  if ((bytes > CLIPBOARD_MAX_BYTES)); then
    log "clipboard item ignored (${bytes} bytes exceeds ${CLIPBOARD_MAX_BYTES})"
    return 1
  fi
}

watch_x11() {
  while clipnotify; do
    printf 'x\n' >"${events}"
  done
}

watch_wayland() {
  export SPICE_CLIPBOARD_EVENTS=${events}
  # Expansion belongs to the watcher shell, which inherits the exported path.
  # shellcheck disable=SC2016
  wl-paste --watch sh -c 'printf "w\n" > "$SPICE_CLIPBOARD_EVENTS"'
}

watch_x11 &
watch_wayland &
printf 'x\n' >"${events}" &

while read -r source_name; do
  active_local_wayland_session_for_user || continue
  case ${source_name} in
    x)
      if clipboard_read_x11 "${current}" && within_limit "${current}" &&
        ! clipboard_item_is_duplicate "${current}" "${SPICE_CLIPBOARD_MIME}" \
          "${last}" "${last_type}"; then
        if clipboard_write_wayland "${current}" "${SPICE_CLIPBOARD_MIME}"; then
          clipboard_remember_item "${current}" "${SPICE_CLIPBOARD_MIME}" \
            "${last}" "${last_type}"
        fi
      fi
      ;;
    w)
      if clipboard_read_wayland "${current}" && within_limit "${current}" &&
        ! clipboard_item_is_duplicate "${current}" "${SPICE_CLIPBOARD_MIME}" \
          "${last}" "${last_type}"; then
        if clipboard_write_x11 "${current}" "${SPICE_CLIPBOARD_X11_TARGET}"; then
          clipboard_remember_item "${current}" "${SPICE_CLIPBOARD_MIME}" \
            "${last}" "${last_type}"
        fi
      fi
      ;;
  esac
done <&8
